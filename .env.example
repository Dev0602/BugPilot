# Required only when running the AI repair agent.
ANTHROPIC_API_KEY=your_api_key_here

# Claude model used by BugPilot.
BUGPILOT_MODEL=claude-haiku-4-5

# Claude API standard pricing per 1 million tokens.
BUGPILOT_INPUT_COST_PER_M=1.0
BUGPILOT_OUTPUT_COST_PER_M=5.0

# Runtime database.
BUGPILOT_DB_PATH=bugpilot.db

# Agent behavior.
BUGPILOT_MAX_ATTEMPTS=3

# Sandbox timeouts in seconds.
BUGPILOT_TEST_TIMEOUT_SEC=60
BUGPILOT_DEPENDENCY_INSTALL_TIMEOUT_SEC=180
